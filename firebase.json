{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/notif.js",
        "headers": {
          "Cache-Control": "no-cache,no-store,must-revalidate"
        }
      }
    ]
  }
}