{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "test-*.html",
      "firebase-debug.log",
      "CATATAN_PROJECT.txt"
    ],
    "headers": [
      {
        "source": "/**(jpg|jpeg|png|gif|webp|svg|ico)",
        "headers": {
          "Cache-Control": "public, max-age=31536000"
        }
      },
      {
        "source": "/**(js|css)",
        "headers": {
          "Cache-Control": "public, max-age=86400"
        }
      },
      {
        "source": "/notif.js",
        "headers": {
          "Cache-Control": "no-cache,no-store,must-revalidate"
        }
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "site": "majalah-rw011"
  }
}
